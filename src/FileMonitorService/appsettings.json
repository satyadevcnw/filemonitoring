{
  "MonitorSettings": {
    "LocalPaths": [
      "C:\\",
      "D:\\"
    ],
    "FileServerPaths": [
      "\\\\192.168.0.143\\akku-fileserver"
    ],
    "FileExtensionFilter": [],
    "MinimumFileSizeBytes": 1,
    "ExcludedPaths": [
      "\\AppData\\",
      "\\Application Data\\",
      "\\Local Settings\\",
      "\\.git\\",
      "\\.vs\\",
      "\\.vscode\\",
      "\\node_modules\\",
      "\\Google\\Chrome\\",
      "\\Microsoft\\Edge\\",
      "\\Mozilla\\Firefox\\"
    ],
    "ExcludedFilePatterns": [
      "*.tmp",
      "*.TMP",
      "~$*",
      "*.crdownload",
      "*.partial",
      "*.lock",
      "thumbs.db",
      "desktop.ini"
    ],
    "OnlyUserInitiatedCopies": true,
    "CsvLogPath": "C:\\ProgramData\\FileMonitorService\\Logs",
    "WriteToWindowsEventLog": true,
    "EventLogSource": "FileMonitorService",
    "EventLogName": "FileMonitorService",
    "IncludeSubdirectories": true,
    "DebounceIntervalMs": 2000
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}
