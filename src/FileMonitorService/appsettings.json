{
  "MonitorSettings": {
    "LocalPaths": [
      "C:\\",
      "D:\\"
    ],
    "FileServerPaths": [
      "\\\\192.168.0.143\\akku-fileserver"
    ],
    "FileExtensionFilter": [],
    "MinimumFileSizeBytes": 1,
    "ExcludedPaths": [
      "\\AppData\\",
      "\\Application Data\\",
      "\\Local Settings\\",
      "\\.git\\",
      "\\.vs\\",
      "\\.vscode\\",
      "\\node_modules\\",
      "\\$Recycle.Bin\\",
      "\\Temp\\",
      "\\Windows\\",
      "\\Program Files\\",
      "\\Program Files (x86)\\",
      "\\ProgramData\\",
      "\\System Volume Information\\",
      "\\Recovery\\",
      "\\MSOCache\\",
      "\\Intel\\",
      "\\PerfLogs\\",
      "\\Boot\\",
      "\\Google\\Chrome\\",
      "\\Microsoft\\Edge\\",
      "\\Mozilla\\Firefox\\",
      "\\Package Cache\\",
      "\\assembly\\",
      "\\.nuget\\",
      "\\obj\\",
      "\\bin\\Debug\\",
      "\\bin\\Release\\"
    ],
    "ExcludedFilePatterns": [
      "*.tmp",
      "*.TMP",
      "~$*",
      "*.crdownload",
      "*.partial",
      "*.lock",
      "*.log",
      "*.etl",
      "*.evtx",
      "*.pf",
      "*.sys",
      "*.dll",
      "*.exe",
      "*.dat",
      "*.cache",
      "*.db-journal",
      "*.db-wal",
      "thumbs.db",
      "desktop.ini",
      "ntuser.dat*",
      "usrclass.dat*"
    ],
    "OnlyUserInitiatedCopies": true,
    "CsvLogPath": "C:\\ProgramData\\FileMonitorService\\Logs",
    "WriteToWindowsEventLog": true,
    "EventLogSource": "FileMonitorService",
    "EventLogName": "FileMonitorService",
    "IncludeSubdirectories": true,
    "DebounceIntervalMs": 2000
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}
