{
  "MonitorSettings": {
    "LocalPaths": [
      "C:\\Users\\Dell\\Desktop",
      "C:\\Users\\Dell\\Documents",
      "C:\\Users\\Dell\\Downloads"
    ],
    "FileServerPaths": [
      "\\\\fileserver\\shared"
    ],
    "FileExtensionFilter": [],
    "MinimumFileSizeBytes": 1,
    "ExcludedPaths": [
      "\\AppData\\",
      "\\Application Data\\",
      "\\Local Settings\\",
      "\\.git\\",
      "\\.vs\\",
      "\\node_modules\\",
      "\\$Recycle.Bin\\",
      "\\Temp\\"
    ],
    "ExcludedFilePatterns": [
      "*.tmp",
      "*.TMP",
      "~$*",
      "*.crdownload",
      "*.partial",
      "*.lock",
      "thumbs.db",
      "desktop.ini"
    ],
    "OnlyUserInitiatedCopies": true,
    "CsvLogPath": "C:\\ProgramData\\FileMonitorService\\Logs",
    "WriteToWindowsEventLog": true,
    "EventLogSource": "FileMonitorService",
    "EventLogName": "FileMonitorService",
    "IncludeSubdirectories": true,
    "DebounceIntervalMs": 2000
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}
